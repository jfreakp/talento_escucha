# Configuración del proyecto
SECRET_KEY=django-insecure-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,https://*.vercel.app

# ─────────────────────────────────────────────
# Supabase - Base de datos
# Copiar desde: Supabase Dashboard → Settings → Database → Connection string
# ─────────────────────────────────────────────
# Opción 1 (recomendada): Transaction pooler - mejor para Vercel serverless
# DATABASE_URL=postgresql://postgres.[TU-PROJECT-REF]:[TU-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Opción 2: Conexión directa - para migraciones
# DATABASE_URL=postgresql://postgres:[TU-PASSWORD]@db.[TU-PROJECT-REF].supabase.co:5432/postgres

DATABASE_URL=postgresql://postgres.[TU-PROJECT-REF]:[TU-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Superusuario de despliegue
SUPERUSER_USERNAME=admin
SUPERUSER_EMAIL=admin@example.com
SUPERUSER_PASSWORD=change-this-password
SUPERUSER_ROLE=ADMIN

# Configuración de correo Gmail
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=tu_correo@gmail.com
EMAIL_HOST_PASSWORD=tu_contraseña_de_aplicacion_aqui
DEFAULT_FROM_EMAIL=tu_correo@gmail.com
